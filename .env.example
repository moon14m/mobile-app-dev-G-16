# Copy to .env.development, .env.staging or .env.production (those files are not committed).
# EXPO_PUBLIC_ values are copied into the app where anyone can read them: public values only, never secrets.

# development | staging | production
EXPO_PUBLIC_APP_ENV=development

# Phase 2 backend address. Phase 1 uses the sample data in src/data/mockData.ts.
# development: http://192.168.1.10:3000   staging: https://staging-api.example.com   production: https://api.example.com
EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Phase 2 Google API key. Restrict it to the app in Google Cloud; never put a server secret here.
EXPO_PUBLIC_YOUTUBE_API_KEY=
